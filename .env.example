# Copy to .env and fill in for a real deployment. Nothing here is required
# to run the demo (`python3 -m app.server`) or the test suite -- both use
# safe defaults.

# Salt for sender-phone-number hashing (app/hashing.py). Generate a long
# random value for any real deployment; the code falls back to a fixed
# demo value if this is unset, which is fine for local/demo use only.
AKIYESI_SENDER_SALT=

# Which LLM backend the redaction/classification/extraction stages use.
# rule_based (default): deterministic, no network, what this iteration runs.
# anthropic_claude: production, requires the two variables below,
#   `pip install -r requirements.txt`, and a machine with network access
#   (see README.md's "Real Claude API setup" section, and run
#   scripts/smoke_test_claude.py before trusting this backend for a live
#   demo -- it has not been exercised against the real API from this
#   repository's own dev sandbox, see docs/ai-usage.md).
AKIYESI_LLM_BACKEND=rule_based
AKIYESI_ANTHROPIC_API_KEY=
# Any Claude model your API key has access to; check
# https://docs.claude.com/en/docs/about-claude/models for the current list
# if this default is no longer available.
AKIYESI_CLAUDE_MODEL=claude-sonnet-4-5-20250929

# SMS provider webhook auth, once app/main_fastapi.py's webhook route
# verifies a signature/token instead of accepting any POST (see the
# "not yet done" list in docs/ai-usage.md).
SMS_PROVIDER=africastalking
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_USERNAME=

# Alternate config/ and data/ locations, mainly for tests and CI.
AKIYESI_CONFIG_DIR=
AKIYESI_DB_PATH=data/akiyesi.db
